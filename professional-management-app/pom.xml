<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.edu.corhuila.telemedia</groupId>
        <artifactId>professional-management-api</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>professional-management-app</artifactId>
    <name>professional-management-app</name>
    <description>Composition root: wires adapters to use cases and declares every limit.</description>

    <dependencies>
        <dependency>
            <groupId>co.edu.corhuila.telemedia</groupId>
            <artifactId>professional-management-core</artifactId>
        </dependency>
        <dependency>
            <groupId>co.edu.corhuila.telemedia</groupId>
            <artifactId>professional-management-adapters</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- NFR-005: request rate, errors and latency for Prometheus on the management port. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- NFR-005: W3C trace context and span export to the platform collector over OTLP. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-java11</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>co.edu.corhuila.telemedia</groupId>
            <artifactId>professional-management-adapters</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Validates every response of the contract tests against the published OpenAPI. -->
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-core</artifactId>
            <version>2.44.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>professional-management-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
