# Variables read by telemed-ia-professional-management-api.
# Real values come from the environment file of telemed-ia-infra-postgres
# (env/dev.env, env/qa.env, env/main.env). Never commit real values.

# HTTP port inside the container.
SERVER_PORT=8080

# Public key of the identity service, used to validate RS256 access tokens.
# PEM in one line with literal \n, for example:
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----
# Alternatively, JWT_PUBLIC_KEY_FILE with the path to the PEM file; set only one of the two.
# It is a public key: the service never holds the private key.
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=

# Shared PostgreSQL instance (Anexo J), application user of this domain.
DB_URL=jdbc:postgresql://localhost:5432/telemed_ia
DB_USERNAME=professional_management_app
DB_PASSWORD=

# Identity service that creates the professionals' accounts (DEC-003).
# The secret is delivered privately by the identity owner and lives only in
# env/<environment>.env of telemed-ia-infra-postgres. Without it, registrations answer 503.
IDENTITY_URL=http://identity-api:8081
SERVICE_CLIENT_ID=professional-management
SERVICE_CLIENT_SECRET=
# Maximum time of each call to the identity service.
IDENTITY_REQUEST_TIMEOUT=5s

# Observability (NFR-005): health and Prometheus metrics on the management port, and
# traces to the OpenTelemetry collector of telemed-ia-infra-postgres.
MANAGEMENT_PORT=9081
OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# Tests only: a disposable PostgreSQL with the migrations of
# telemed-ia-professional-management-db applied. Without it the persistence
# tests are skipped (Anexo I). Never point it at a shared or real database.
# TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:55433/telemed_ia?user=<user>&password=<password>

# Deployment: deploy/compose.yml reads these names from the environment file of
# telemed-ia-infra-postgres and passes them to the variables above.
PG_DATABASE=telemed_ia
PROFESSIONAL_MANAGEMENT_APP_USER=professional_management_app
PROFESSIONAL_MANAGEMENT_APP_PASSWORD=
PROFESSIONAL_MANAGEMENT_SERVICE_CLIENT_ID=professional-management
PROFESSIONAL_MANAGEMENT_SERVICE_CLIENT_SECRET=
