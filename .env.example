# Variables read by telemed-ia-professional-management-api.
# Real values come from the environment file of telemed-ia-infra-postgres
# (env/dev.env, env/qa.env, env/main.env). Never commit real values.

# HTTP port inside the container.
SERVER_PORT=8080

# Shared PostgreSQL instance (Anexo J), application user of this domain.
DB_URL=jdbc:postgresql://localhost:5432/telemed_ia
DB_USERNAME=professional_management_app
DB_PASSWORD=
