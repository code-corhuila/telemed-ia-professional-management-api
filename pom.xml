<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Professional Management API: hexagonal service in three Maven modules (Anexo C).
          professional-management-core      domain and application; no framework dependency
          professional-management-adapters  HTTP, persistence and identity adapters
          professional-management-app       composition root (Spring Boot application)
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.corhuila.telemedia</groupId>
    <artifactId>professional-management-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>telemed-ia-professional-management-api</name>
    <description>Professional Management bounded context for TeleMed IA.</description>

    <modules>
        <module>professional-management-core</module>
        <module>professional-management-adapters</module>
        <module>professional-management-app</module>
    </modules>

    <properties>
        <!-- Anexo I: Java 21. -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <springdoc.version>2.8.9</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>co.edu.corhuila.telemedia</groupId>
                <artifactId>professional-management-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>co.edu.corhuila.telemedia</groupId>
                <artifactId>professional-management-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>co.edu.corhuila.telemedia</groupId>
                <artifactId>professional-management-adapters</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
